{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infinity-arcana:schema:pack:1.0.0",
  "title": "Infinity Arcana expansion pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "contentVersion",
    "status",
    "defaultLocale",
    "name",
    "subtitle",
    "description",
    "domainIds",
    "tags",
    "cardIds",
    "coverAssetId",
    "accessPolicy",
    "compositionPolicy",
    "localizedContent",
    "publication"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/stableId"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/contentStatus"
    },
    "defaultLocale": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/locale"
    },
    "name": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/localizedText"
    },
    "subtitle": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/localizedText"
    },
    "description": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/localizedText"
    },
    "domainIds": {
      "allOf": [
        {
          "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/stableIdArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "tags": {
      "allOf": [
        {
          "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/stableIdArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "cardIds": {
      "allOf": [
        {
          "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/stableIdArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "coverAssetId": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/stableId"
    },
    "accessPolicy": {
      "type": "object",
      "required": [
        "accessLevel",
        "entitlementId"
      ],
      "properties": {
        "accessLevel": {
          "enum": [
            "free",
            "premium",
            "event",
            "internal"
          ]
        },
        "entitlementId": {
          "oneOf": [
            {
              "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "compositionPolicy": {
      "type": "object",
      "required": [
        "type",
        "expectedCardCount",
        "allowDuplicateArchetypes"
      ],
      "properties": {
        "type": {
          "enum": [
            "one-per-major-archetype",
            "curated"
          ]
        },
        "expectedCardCount": {
          "type": "integer",
          "minimum": 1
        },
        "allowDuplicateArchetypes": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "localizedContent": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Z]{2})?$": {
          "$ref": "#/$defs/localeContent"
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "$ref": "urn:infinity-arcana:schema:shared:1.0.0#/$defs/publication"
    }
  },
  "$defs": {
    "localeContent": {
      "type": "object",
      "required": [
        "concept",
        "curatorialRule",
        "readingTone"
      ],
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "curatorialRule": {
          "type": "string",
          "minLength": 1
        },
        "readingTone": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

