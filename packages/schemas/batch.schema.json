{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infinity-arcana:schema:batch:1.0.0",
  "title": "Infinity Arcana content generation batch",
  "type": "object",
  "required": ["schemaVersion", "id", "targetArchetypeId", "requestedCount", "formDistribution", "requiredVariationAxes", "avoidTerms", "referenceReleaseId", "outputLocale"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^batch-[a-z0-9-]+$"},
    "targetArchetypeId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "targetDomainIds": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "uniqueItems": true},
    "requestedCount": {"type": "integer", "minimum": 1, "maximum": 100},
    "formDistribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "requiredVariationAxes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "avoidTerms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "referenceReleaseId": {"type": "string"},
    "outputLocale": {"const": "ja-JP"}
  },
  "additionalProperties": false
}
